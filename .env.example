# ---------------------------------------------------------------------------
# AI PR Reviewer - local development configuration
# Copy to .env and fill in the values. Do NOT commit .env.
# ---------------------------------------------------------------------------

# Bitbucket Data Center REST API (use an HTTP access token)
BITBUCKET_BASE_URL=https://bitbucket.example.com
BITBUCKET_USERNAME=
# HTTP access token, sent as `Authorization: Bearer <token>`
BITBUCKET_API_TOKEN=
# Webhook signature secret for POST /webhooks/bitbucket. Set it in the
# Bitbucket webhook config; pulls with a wrong/missing X-Hub-Signature are
# rejected (401). Empty = signatures are not checked.
BITBUCKET_WEBHOOK_SECRET=

# HTTP deadline (milliseconds) for every Bitbucket/GitHub REST call. Prevents a
# dead or lossy proxy — a response that never arrives or stalls mid-stream —
# from wedging a review in a "running" stage forever. 0 disables the deadline.
API_REQUEST_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# GitHub — parallel backend (GitHub repos are reviewed alongside Bitbucket).
# Leave every GITHUB_* line empty on a Bitbucket-only instance. GitHub only needs
# its own block; the same server serves whichever backends have credentials.
# ---------------------------------------------------------------------------
# REST API base. Defaults to github.com's API; for GitHub Enterprise Server set
# e.g. https://git.example.com/api/v3 (no trailing slash). The git clone host
# is derived from this (github.com vs the GHES origin).
GITHUB_API_BASE_URL=https://api.github.com
# Personal access token (classic, `repo` scope) — sent as Authorization: Bearer.
# GitHub App / installation-token auth works unchanged with the same client.
GITHUB_TOKEN=
# Bot login for this reviewer, used to filter our own comments out of the PR
# discussion context. Empty = unknown bot identity (heuristic still applies).
GITHUB_USERNAME=
# Webhook signature secret for POST /webhooks/github (X-Hub-Signature-256). Set
# it in the GitHub App / repository webhook config; a wrong/missing signature is
# rejected (401). Empty = the endpoint is DISABLED (every delivery returns 403,
# including ping) — fail closed, never "unsigned allowed". While a secret is
# set, GitHub's unsigned `ping` test event is always acknowledged.
GITHUB_WEBHOOK_SECRET=

# Auto-review is ON for every repository by default; list owner/repo
# (comma-separated, e.g. acme/widgets) here to disable the automatic triggers
# there (manual /ai-review comments still work). Empty = all on.
GITHUB_AUTO_REVIEW_OFF_REPOS=

# Set to 1 to post reviews as GitHub comments (default 0 = safe local run).
# Independent of PUBLISH_TO_BITBUCKET: each platform publishes only when its own
# gate is on.
PUBLISH_TO_GITHUB=0

# Local dev only: set false if the instance uses non-public CAs your machine
# does not trust. The default bitbucket.example.com instance is trusted by default on managed workstations.
VERIFY_TLS=true

# Reviewer allowlist for /ai-review and auto-reviews (comma-separated). Empty = any
# commenter/reviewer. Also the set whose addition as a PR reviewer starts an auto-review.
ALLOWED_REVIEWER_USERS=

# Auto-review is ON for every repository by default; list PROJECT/repo-slug
# (comma-separated) here to disable it there, e.g. ACME/acme-app2. Empty = all on.
AUTO_REVIEW_OFF_REPOS=
# Branch pairs (SOURCE>TARGET, * = any characters) whose pull requests never start a
# reviewer-added review, e.g. develop>release/*,release/*>develop,release/*>release/*.
# Empty = no skip.
REVIEW_ON_REVIEWER_ADDED_SKIP=

# Queue / jobs
JOBS_DIR=./jobs
MAX_CONCURRENT_REVIEWS=2
# Reviewer concurrency: 0 (default) = the active reviewers (A/B/C[/D]) run in
# parallel; 1 = strictly one at a time (for small hosts such as a 1-vCPU VM);
# N = at most N at a time.
REVIEWER_PARALLELISM=0

# Project context: per-repo curated files `<PROJECT>-<repo>.md` in
# REVIEW_CONTEXT_DIR are attached verbatim to every review of that repo.
# FETCH_REPO_CONTEXT=1 also attaches the repo's own AGENTS.md (head SHA).
# These files are also editable from the dashboard's "Context" page — the
# server writes them straight to REVIEW_CONTEXT_DIR (needs write permission;
# the pod user owns it in the container image).
REVIEW_CONTEXT_DIR=./contexts
FETCH_REPO_CONTEXT=1

# AI-assisted context drafting: the dashboard's Context page "✨ AI draft"
# runs a dedicated `context-gen` agent to draft/refine a repo's context file
# from developer notes (false positives, conventions). The draft only lands in
# the editor — it is never saved automatically (context is authoritative to
# reviewers). Empty CONTEXT_GEN_MODEL falls back to CONSENSUS_MODEL, then
# REVIEWER_MODEL_A; with none configured the action is disabled.
CONTEXT_GEN_MODEL=
CONTEXT_GEN_TIMEOUT_SECONDS=300

# Public PR comment gate: findings below either threshold go to a compact
# "Minor" list and don't drive the merge verdict (internal report shows all).
COMMENT_MIN_SEVERITY=MEDIUM
COMMENT_MIN_CONFIDENCE=0.5

# PR discussion (author clarifications, v0.3.7) and screenshots pasted into the
# description/comments, transcribed by the `pr-vision` agent for the review
# context (v0.3.9+). Both additive + non-fatal. The transcription runs through
# the same `opencode run --file` path as the reviewers/consensus.
# VISION_MODEL is OPTIONAL: pick an IMAGE-CAPABLE model (declared
# `capabilities.input` in the opencode config — e.g. GPT-6 Luna on the LLM
# Gateway, Claude Haiku 5.5, or Qwen 27B; the Models dialog enforces this).
# UNSET/EMPTY DISABLES screenshot transcription entirely (no downloads, no
# context block, no vision cost row). Routing/auth come solely from the opencode
# agent config — there are no vision-specific provider/token/base-URL knobs.
FETCH_PR_DISCUSSION=1
FETCH_PR_IMAGES=1
# VISION_MODEL=llmgw-gpt/gpt-6-luna
VISION_MAX_IMAGES=6
VISION_MAX_IMAGE_BYTES=10485760
VISION_FETCH_TIMEOUT_MS=30000
VISION_CALL_TIMEOUT_MS=60000
# Scratch root for the vision transcription temp dirs. MUST live INSIDE the
# project root: `opencode run` resolves its session's project from the temp
# dir, and a bare /tmp dir can be taken for an agent-less project, making the
# shared server miss .opencode/agents/pr-vision.md and fail every screenshot
# with "Agent not found: pr-vision" (all images unreadable). Default is fine —
# only override to relocate the scratch off the default volume.
# VISION_SCRATCH_DIR=./data/vision-scratch
# Age (ms) after which stale per-image scratch dirs (leftovers of a crashed/
# killed transcription) are swept out of VISION_SCRATCH_DIR. A live dir never
# lives longer than one VISION_CALL_TIMEOUT_MS window, so the sweep is floored
# at two call timeouts and an absolute floor (60 s) and can never touch a
# concurrent review's dir. 0 disables.
VISION_SCRATCH_MAX_AGE_MS=3600000

# Optional: shallow-checkout the reviewed commit (git) into WORKSPACE_ROOT so
# reviewers can read real files beyond the diff. Best-effort and non-fatal.
REVIEW_CHECKOUT=0
CHECKOUT_KEEP=3
# Workspace disk guards (issue #11): bare-repo git packs grew unbounded until
# the 2 GiB PVC was full and reviews failed ENOSPC. `gc` consolidates packs once
# a repo has this many; the workspace is LRU-evicted above WORKSPACE_MAX_BYTES;
# a fetch is preceded by reclaim when free space drops below DISK_MIN_FREE_BYTES.
CHECKOUT_GC_PACKS=20
CHECKOUT_WORKSPACE_MAX_BYTES=1610612736
DISK_MIN_FREE_BYTES=134217728

# Reviewer / consensus models (opencode provider/model IDs).
# NOTE: DiscreteStack (myprovider/discretestack-stable*) is retired and removed
# from the bundled opencode config — the endpoint is decommissioned (HTTP 404).
# Reviewer A uses its equivalent, DeepSeek V4 Flash (MSP).
REVIEWER_MODEL_A=llmgw-msp/DeepSeek-V4-Flash
REVIEWER_MODEL_B=llmgw-openai/deepseek-v4-pro
REVIEWER_MODEL_C=llmgw-gpt/gpt-6-luna
# Reviewer D (language, i18n & translation quality) runs only when the PR
# changes translation/content files. Prefer a strong multilingual model.
# Unset = falls back to REVIEWER_MODEL_A.
REVIEWER_MODEL_D=llmgw-openai/deepseek-v4-pro
# consensus gets ~60 KB of reviewer reports; Haiku 5.5 handles that reliably.
CONSENSUS_MODEL=llmgw/claude-haiku-5-5

# Reviewer D activation: a PR is treated as a translation/content PR when any
# changed file matches one of these comma-separated path regexes. Empty = the
# defaults: `<dir>/i18n/*.json` and gettext `.po`/`.pot`.
TRANSLATION_PATH_PATTERNS=

# AI execution
OPENCODE_BIN=opencode
# 0 (default) = `opencode run` connects to the shared background server (no
# per-run server boot, no startup race). Set 1 = each run starts its own
# private server (strict isolation / fresh credentials; opt-in).
OPENCODE_STANDALONE=0
AGENT_MAX_RETRIES=2
REVIEWER_TIMEOUT_SECONDS=900
CONSENSUS_TIMEOUT_SECONDS=900

# Set to 1 (or pass --publish on the CLI) to post the report as a PR comment.
# Default 0: safe local run, keeps comment-draft.md in the job dir instead.
PUBLISH_TO_BITBUCKET=0

# Git / diff preparation
GIT_FETCH_DEPTH=200
# Diff budget for the agent context; over it, whole files are dropped (tests
# and lockfiles/generated first) and listed for the agents.
MAX_DIFF_BYTES=300000

# Server / scheduler (webhook milestone)
PORT=8123
START_SCHEDULER=1
WORKSPACE_ROOT=./data/workspaces
SQLITE_PATH=./data/ai-review.sqlite3

# Dashboard model display names. JSON object mapping provider/model id ->
# human-friendly label, injected into ui/app.js at serve time (zero-divergence:
# the static UI stays identical across deployments and each one overrides
# names via this env / the opencode provider config). Empty = the portable
# example-gateway defaults from src/config.js.
# MODEL_OVERRIDES_JSON={"llmgw-gpt/gpt-6-luna":"GPT-6 Luna"}

# Auth for Example LLM Gateway provider (required by llmgw-* models inside OpenCode)
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_VERTEX_BASE_URL=https://llm-gateway.example.com/api/google/v1